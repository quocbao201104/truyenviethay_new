{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.truyenviethay.id.vn/sitemap.xml" },
    { "source": "/sitemaps/:path*", "destination": "https://api.truyenviethay.id.vn/sitemaps/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/index.html", "destination": "/index.html" },
    { "source": "/", "destination": "/api/render?path=/" },
    { "source": "/:path*", "destination": "/api/render?path=/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/sitemaps/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
