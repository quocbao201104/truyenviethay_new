{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.truyenviethay.id.vn/sitemap.xml" },
    { "source": "/sitemaps/:path*", "destination": "https://api.truyenviethay.id.vn/sitemaps/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/index.html", "destination": "/index.html" },
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "missing": [{ "type": "header", "key": "x-seo-head-render" }],
      "destination": "/api/render?path=/$1"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=900, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/sitemaps/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=900, stale-while-revalidate=3600" }
      ]
    }
  ]
}
