PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://127.0.0.1:5173
BASE_URL=http://localhost:3000
SITEMAP_SITE_URL=https://truyenviethay.id.vn
SITEMAP_CHAPTERS_PER_FILE=10000
SITEMAP_MIN_STORIES_PER_CATEGORY=1
# Optional: enable only when audio pages are self-canonical + indexable
SITEMAP_INCLUDE_AUDIO=false

# Direct VPS MySQL
# Prefer DATABASE_URL if you already have a full connection string.
# Example:
# DATABASE_URL=mysql://db_user:db_password@your-do-vps-ip:3306/truyenviethay
DB_HOST=your-do-vps-ip
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false

GOOGLE_CLIENT_ID=

# Keep Redis local if you only want DB to point to VPS
REDIS_URL=redis://127.0.0.1:6380/0

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# Security / Logging
JWT_SECRET=
LOG_DIR=logs
LOG_LEVEL=info
