# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis (optional, real-time/cache)
REDIS_URL=

# Authentication
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (chapter storage)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_REGION=

# Logging
LOG_DIR=
LOG_LEVEL=

# Optional: Cache hit/miss logging (1 = enable)
# LOG_CACHE_HIT_MISS=1

# History cleanup: cap entries per user (0 = disabled, default 200)
# HISTORY_CAP_PER_USER=200
