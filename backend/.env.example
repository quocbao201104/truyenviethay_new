PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional comma-separated list for extra frontend domains:
# CLIENT_URLS=https://truyenviethay.id.vn,https://www.truyenviethay.id.vn
# CORS_ORIGINS=https://staging.example.com
BASE_URL=http://localhost:3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Or use a single connection string:
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/database_name
# DB_SOCKET_PATH=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_CONNECTION_LIMIT=25
# DB_CONNECT_TIMEOUT=10000

GOOGLE_CLIENT_ID=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Or use a single connection string:
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# REDIS_TLS=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_REGION=

# Security / Logging
JWT_SECRET=
LOG_DIR=logs
LOG_LEVEL=info
